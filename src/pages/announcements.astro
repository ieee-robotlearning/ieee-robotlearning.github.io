---
import { getCollection } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const announcements = (await getCollection('announcements')).sort((a, b) => {
  const aPublished = a.data.postDate ?? a.data.date;
  const bPublished = b.data.postDate ?? b.data.date;
  return bPublished.valueOf() - aPublished.valueOf()
    || b.data.date.valueOf() - a.data.date.valueOf();
});

const base = import.meta.env.BASE_URL;
const withBase = (path = '') => `${base.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
const getSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');
const formatDate = (date: Date) => date.toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const formatRange = (start: Date, end?: Date) => {
  if (!end) return formatDate(start);
  const sameMonth = start.getUTCMonth() === end.getUTCMonth() && start.getUTCFullYear() === end.getUTCFullYear();
  if (sameMonth) {
    return `${start.toLocaleDateString('en', { month: 'long', timeZone: 'UTC' })} ${start.getUTCDate()}-${end.getUTCDate()}, ${end.getUTCFullYear()}`;
  }
  return `${formatDate(start)}-${formatDate(end)}`;
};
---

<BaseLayout title="Announcements" description="News, events, and community updates from the IEEE RAS TC on Robot Learning.">
  <section class="page-intro">
    <div class="container">
      <SectionHeading
        eyebrow="Announcements"
        title="News and community updates."
        copy="Follow upcoming events, calls for participation, conference meetups, and other activity from the Robot Learning TC."
      />
    </div>
  </section>
  <section class="announcements-section">
    <div class="container announcements-list">
      {announcements.map((item) => (
        <a class="announcement-card card" href={withBase(`/announcements/${getSlug(item.id)}/`)}>
          <div>
            <p class="date">{formatRange(item.data.date, item.data.endDate)}</p>
            {item.data.postDate && <p class="post-date">Posted {formatDate(item.data.postDate)}</p>}
          </div>
          <div>
            <span>{item.data.type}</span>
            <h2>{item.data.title}</h2>
            <p>{item.data.description}</p>
          </div>
          <ArrowRight class="card-arrow" size={22} aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding: 6rem 0 3rem;
  }

  .announcements-section {
    padding: 1rem 0 6rem;
  }

  .announcements-list {
    display: grid;
    gap: 1rem;
  }

  .announcement-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(190px, 0.28fr) 1fr auto;
    gap: 1.2rem;
    align-items: start;
    padding: 1.15rem;
    overflow: hidden;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .announcement-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--accent);
    content: "";
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .announcement-card:hover,
  .announcement-card:focus-visible {
    border-color: rgba(14, 159, 189, 0.45);
    background: #fff;
    box-shadow: 0 20px 56px rgba(25, 35, 45, 0.13);
    transform: translateY(-2px);
  }

  .announcement-card:hover::before,
  .announcement-card:focus-visible::before {
    opacity: 1;
  }

  .announcement-card:focus-visible {
    outline: 3px solid rgba(14, 159, 189, 0.24);
    outline-offset: 3px;
  }

  .card-arrow {
    color: var(--accent-strong);
    margin-top: 0.2rem;
    opacity: 0.7;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .announcement-card:hover .card-arrow,
  .announcement-card:focus-visible .card-arrow {
    opacity: 1;
    transform: translateX(3px);
  }

  .date,
  .post-date,
  h2,
  p {
    margin: 0;
  }

  .date {
    color: var(--accent-strong);
    font-weight: 900;
    line-height: 1.2;
  }

  .post-date {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 760;
    margin-top: 0.32rem;
  }

  span {
    color: var(--signal);
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.08;
    margin-top: 0.35rem;
  }

  .announcement-card p:not(.date):not(.post-date) {
    color: var(--muted);
    line-height: 1.62;
    margin-top: 0.55rem;
  }

  @media (max-width: 720px) {
    .announcement-card {
      grid-template-columns: 1fr;
    }

    .card-arrow {
      justify-self: start;
      margin-top: -0.2rem;
    }
  }
</style>
