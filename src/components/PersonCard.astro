---
import { existsSync } from 'node:fs';
import { Globe } from '@lucide/astro';

interface Props {
  name: string;
  role: string;
  affiliation: string;
  location?: string;
  country?: string;
  email?: string;
  href?: string;
  website?: string;
  linkedin?: string;
  image?: string;
  imageScale?: number;
  imageX?: string;
  imageY?: string;
}

const {
  name,
  role,
  affiliation,
  location,
  country,
  email,
  href,
  website,
  linkedin,
  image,
  imageScale = 1,
  imageX = '0px',
  imageY = '0px',
} = Astro.props;
const place = [location, country].filter(Boolean).join(', ');
const base = import.meta.env.BASE_URL;
const withBase = (path = '') => `${base.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
const initials = name.split(' ').map((part) => part[0]).join('').slice(0, 2);
const imagePath = image?.replace(/^\//, '');
const hasImage = imagePath ? existsSync(new URL(`../../public/${imagePath}`, import.meta.url)) : false;
const imageStyle = [
  `--avatar-scale: ${imageScale}`,
  `--avatar-x: ${imageX}`,
  `--avatar-y: ${imageY}`,
].join('; ');
const websiteUrl = website ?? href;
---

<article class="person-card card">
  <div class="avatar" aria-hidden="true">
    {hasImage && image ? <img src={withBase(image)} alt="" loading="lazy" decoding="async" style={imageStyle} /> : initials}
  </div>
  <div class="person-info">
    <div class="person-heading">
      <h3>{name}</h3>
      {(linkedin || websiteUrl) && (
        <div class="profile-links" role="group" aria-label={`${name} profile links`}>
          {linkedin && (
            <a class="profile-link linkedin-link" href={linkedin} aria-label={`${name} on LinkedIn`} title="LinkedIn" rel="noreferrer">
              <span aria-hidden="true">in</span>
            </a>
          )}
          {websiteUrl && (
            <a class="profile-link" href={websiteUrl} aria-label={`${name} website`} title="Website" rel="noreferrer">
              <Globe size={17} aria-hidden="true" />
            </a>
          )}
        </div>
      )}
    </div>
    <p class="role">{role}</p>
    <p>{affiliation}</p>
    {place && <p class="place">{place}</p>}
    {email && <a class="email" href={`mailto:${email}`}>{email}</a>}
  </div>
</article>

<style>
  .person-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1rem;
    min-height: 180px;
  }

  .avatar {
    position: relative;
    display: grid;
    width: 54px;
    height: 54px;
    place-items: center;
    border-radius: 8px;
    background: #12202a;
    color: #9ee7f2;
    font-weight: 900;
    overflow: hidden;
  }

  .avatar img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(var(--avatar-x), var(--avatar-y)) scale(var(--avatar-scale));
    transform-origin: center center;
  }

  h3,
  p {
    margin: 0;
  }

  .person-info {
    min-width: 0;
  }

  .person-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  h3 {
    font-size: 1.05rem;
    line-height: 1.18;
    min-width: 0;
  }

  .profile-links {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.38rem;
  }

  .profile-link {
    display: inline-grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    color: var(--accent-strong);
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .profile-link:hover,
  .profile-link:focus-visible {
    border-color: rgba(14, 159, 189, 0.45);
    background: rgba(17, 184, 217, 0.1);
    color: #075d70;
    transform: translateY(-1px);
  }

  .profile-link:focus-visible {
    outline: 3px solid rgba(14, 159, 189, 0.2);
    outline-offset: 2px;
  }

  .linkedin-link span {
    font-size: 0.94rem;
    font-weight: 950;
    letter-spacing: 0;
    line-height: 1;
  }

  .role {
    color: var(--signal);
    font-size: 0.86rem;
    font-weight: 850;
    margin-top: 0.25rem;
  }

  p:not(.role) {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
    margin-top: 0.35rem;
  }

  .place {
    color: #748291;
  }

  .email {
    display: inline-block;
    color: var(--accent-strong);
    font-size: 0.86rem;
    font-weight: 780;
    margin-top: 0.55rem;
    overflow-wrap: anywhere;
  }
</style>
